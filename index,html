<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Spoken Nursing Care Plan: Multi-Choice Register Challenge</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    @keyframes bamShake {
      0% { transform: translate(0, 0) rotate(0deg); }
      15% { transform: translate(-12px, -12px) rotate(-3deg); }
      30% { transform: translate(12px, 12px) rotate(3deg); }
      45% { transform: translate(-10px, 10px) rotate(-2deg); }
      60% { transform: translate(10px, -10px) rotate(2deg); }
      75% { transform: translate(-5px, 0px) rotate(-1deg); }
      100% { transform: translate(0, 0) rotate(0deg); }
    }
    .bam-effect {
      animation: bamShake 0.45s ease-in-out;
    }
    .gradient-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f2a4a 100%);
    }
  </style>
</head>
<body class="gradient-bg text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- TOP HEADER -->
  <header class="bg-slate-900/80 backdrop-blur border-b border-slate-700/60 sticky top-0 z-40 px-4 py-3 shadow-lg">
    <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div>
        <h1 class="text-xl md:text-2xl font-extrabold text-teal-400 tracking-wide">
          🏥 Nursing Care Plan: Multi-Option Challenge
        </h1>
        <p class="text-xs text-slate-400">Curriculum & Author: <span class="text-amber-300 font-semibold">Giyono Asfarrasyid</span></p>
      </div>

      <!-- SCOREBOARD & STATS -->
      <div class="flex items-center gap-4 bg-slate-800/90 px-4 py-2 rounded-xl border border-slate-700">
        <div class="text-center">
          <span class="text-xs text-slate-400 block uppercase font-bold tracking-wider">Score</span>
          <span id="scoreDisplay" class="text-2xl font-black text-amber-400">0</span>
        </div>
        <div class="h-8 w-px bg-slate-700"></div>
        <div class="text-center">
          <span class="text-xs text-slate-400 block uppercase font-bold tracking-wider">Streak</span>
          <span id="streakDisplay" class="text-2xl font-black text-emerald-400">0🔥</span>
        </div>
        <div class="h-8 w-px bg-slate-700"></div>
        <div class="text-center">
          <span class="text-xs text-slate-400 block uppercase font-bold tracking-wider">Case</span>
          <span id="caseProgressDisplay" class="text-sm font-bold text-sky-300">1 / 10</span>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main id="mainContainer" class="flex-grow max-w-5xl w-full mx-auto p-4 md:p-6 flex flex-col gap-6">

    <!-- GAME SETTINGS / FILTERS -->
    <section class="bg-slate-800/60 rounded-2xl p-4 border border-slate-700/80 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-2">
        <label for="moduleSelect" class="text-sm font-semibold text-slate-300">Target Module:</label>
        <select id="moduleSelect" class="bg-slate-900 border border-slate-600 text-teal-300 text-sm rounded-lg p-2 focus:ring-2 focus:ring-teal-400 outline-none">
          <option value="all"> All Clinical Modules (Mixed Challenge)</option>
          <option value="1">Module 1: Intake & History Taking</option>
          <option value="2">Module 2: Vital Signs & Reporting</option>
          <option value="3">Module 3: Nursing Diagnosis & Planning</option>
          <option value="4">Module 4: ISBAR & Physician Consult</option>
          <option value="5">Module 5: Medication Administration Safety</option>
          <option value="6">Module 6: Clinical Interventions & Dressings</option>
          <option value="7">Module 7: Patient Observation & Handover</option>
          <option value="8">Module 8: Admin, Records & HR Dialogue</option>
          <option value="9">Module 9: Pediatric & Family-Centered Care</option>
          <option value="10">Module 10: Critical Care & Rapid Response</option>
          <option value="11">Module 11: Infection Control & Isolation</option>
          <option value="12">Module 12: Discharge & Rehabilitation</option>
        </select>
      </div>

      <div class="flex gap-2">
        <button id="resetBtn" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs px-3 py-2 rounded-lg transition font-medium">
          🔄 Reset Game
        </button>
        <button id="soundToggle" class="bg-teal-700 hover:bg-teal-600 text-white text-xs px-3 py-2 rounded-lg transition font-medium">
          🔊 Sound: ON
        </button>
      </div>
    </section>

    <!-- PROMPT & SCENARIO CARD -->
    <section class="bg-slate-800/90 rounded-2xl p-6 border border-slate-700 shadow-xl relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span id="badgeCategory" class="bg-teal-900/80 text-teal-300 text-xs font-bold px-3 py-1 rounded-full uppercase border border-teal-500/40">
          Module Phase
        </span>
        <span id="badgeTargetType" class="bg-amber-900/80 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-500/40">
          Select MULTIPLE Answers
        </span>
      </div>

      <!-- VISUAL DESCRIPTION -->
      <div id="visualDescription" class="italic text-xs text-slate-400 mb-4 bg-slate-900/60 p-3 rounded-lg border-l-4 border-sky-500">
        "Visual description of clinical setting..."
      </div>

      <!-- FORMAL CLINICAL PROMPT -->
      <div class="mb-4">
        <h2 class="text-xs uppercase font-extrabold text-slate-400 tracking-wider mb-1">Formal Clinical Statement / Situation:</h2>
        <div id="formalPrompt" class="text-base md:text-lg font-bold text-white bg-slate-950/80 p-4 rounded-xl border border-slate-700/80 text-teal-200">
          "Formal text will appear here..."
        </div>
      </div>

      <!-- CHALLENGE QUESTION INSTRUCTION -->
      <div class="bg-amber-950/40 border border-amber-700/50 p-3 rounded-xl mb-4">
        <p id="challengeInstruction" class="text-sm font-semibold text-amber-200">
          ⚠️ Select ALL valid informal/reassuring equivalents or correct answers that match this situation (At least 2 or more options are correct!).
        </p>
      </div>

      <!-- MULTI-CHOICE OPTIONS MATRIX -->
      <div id="optionsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-3 my-4">
        <!-- Options injected dynamically -->
      </div>

      <!-- SUBMIT ACTION BUTTON -->
      <div class="mt-6 flex justify-end">
        <button id="submitBtn" class="w-full md:w-auto bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-400 hover:to-emerald-500 text-slate-950 font-black text-lg px-8 py-3.5 rounded-xl shadow-lg transition transform active:scale-95 disabled:opacity-50">
          CHECK SELECTIONS (+100 / -100) 🎯
        </button>
      </div>
    </section>

    <!-- FEEDBACK OVERLAY / RESULT BOX -->
    <div id="feedbackBanner" class="hidden p-4 rounded-xl border text-center font-bold text-lg transition duration-300">
      <div id="feedbackText"></div>
      <div id="feedbackSubtext" class="text-xs font-normal mt-1"></div>
      <button id="nextCaseBtn" class="mt-3 bg-slate-900 text-white text-sm px-5 py-2 rounded-lg border border-slate-600 hover:bg-slate-800 transition">
        Next Scenario ➔
      </button>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-950 border-t border-slate-800 p-4 text-center text-xs text-slate-500">
    <p>Spoken English for Nursing Care Plan Training System • Designed for International Nursing Curricula</p>
    <p class="mt-1">Content & Pedagogical Framework © Giyono Asfarrasyid</p>
  </footer>

  <!-- AUDIO SYNTHESIZER & GAME SCRIPT -->
  <script>
    // --- WEB AUDIO API SOUND GENERATOR ---
    class SoundEffects {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
      }
      playCorrect() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        
        // Play excited ascending fan-fare chord (C5, E5, G5, C6)
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + (idx * 0.08));
          gain.gain.setValueAtTime(0.15, now + (idx * 0.08));
          gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.08) + 0.3);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now + (idx * 0.08));
          osc.stop(now + (idx * 0.08) + 0.35);
        });
      }
      playIncorrect() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        
        // Play harsh low-frequency buzzer drop sound
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.4);
        
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
        
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.45);
      }
    }

    const soundFX = new SoundEffects();

    // --- GAME DATABASE: MULTI-SELECTION CHALLENGES ---
    // Each scenario contains multiple choices (some correct, some incorrect/distractors).
    const gameScenarios = [
      {
        id: 101,
        module: "1",
        moduleTitle: "Module 1: Intake & Assessment",
        visual: "A bright hospital ward room. The nurse approaches bedside with a clipboard while patient sits up in bed.",
        formalPrompt: "Good morning, Mr. Davis. My name is Nurse Sarah. I need to complete your admission assessment and review your medical history. Could you rate your current abdominal pain on a scale from 0 to 10?",
        instruction: "Select ALL options below that represent appropriate, valid informal/reassuring ways to communicate this assessment to the patient:",
        options: [
          { text: "Hi there, Mr. Davis! I'm Sarah. We're just going to run through a quick chat about how you're feeling.", isCorrect: true },
          { text: "On a scale of 0 to 10, where 10 is the worst pain ever, how bad is it hurting right now?", isCorrect: true },
          { text: "I need you to swallow this Cefazolin pill immediately without asking questions.", isCorrect: false, reason: "Incorrect topic: Medication administration trap." },
          { text: "Hey, Mr. Davis! We're just taking a quick look at what's bothering you today and checking your tummy discomfort.", isCorrect: true },
          { text: "Doctor, the patient is febrile at 38.8°C with a blood pressure drop.", isCorrect: false, reason: "Incorrect audience: Formal physician handoff statement." }
        ]
      },
      {
        id: 102,
        module: "2",
        moduleTitle: "Module 2: Vital Signs & Escalation",
        visual: "Post-op ward. Nurse stands with an electronic vital signs monitor next to patient bed while head nurse listens.",
        formalPrompt: "Head Nurse, Patient Davis in Bed 4 is febrile at 38.8°C, with a pulse of 112 beats per minute and blood pressure of 90/60 mmHg.",
        instruction: "Select ALL options that correctly rephrase this vital signs alert into informal/colloquial clinical speech between nursing staff:",
        options: [
          { text: "Hey, just letting you know Mr. Davis in Bed 4 has spiked a fever of 38.8, and his blood pressure dropped to 90 over 60.", isCorrect: true },
          { text: "Bed 4's numbers just took a dip—his heart is racing at 112 and his BP is down to 90/60.", isCorrect: true },
          { text: "Can I grab his ID and insurance card to get him checked into the computer system?", isCorrect: false, reason: "Incorrect context: Administrative intake statement." },
          { text: "I'm going to clean up your surgical wound and put a fresh bandage on it now.", isCorrect: false, reason: "Incorrect context: Treatment intervention statement." }
        ]
      },
      {
        id: 103,
        module: "4",
        moduleTitle: "Module 4: ISBAR Physician Consult",
        visual: "Nurse at the central workstation speaking into the telephone receiver while reviewing EHR lab results.",
        formalPrompt: "Dr. Evans, I am calling regarding Mr. Davis. Situation: Sudden shortness of breath and blood pressure drop. Background: Post-op Day 1 abdominal surgery. Assessment: SpO2 dropped to 88%. Recommendation: Requesting immediate bedside evaluation.",
        instruction: "Select ALL options that validly express this ISBAR escalation to the physician (formal or conversational equivalents):",
        options: [
          { text: "Hi Dr. Evans, it's Sarah from Ward 3. Mr. Davis in Bed 4 is suddenly getting really short of breath and his oxygen dropped to 88%. We need you to come take a look right away.", isCorrect: true },
          { text: "Dr. Evans, Bed 4 is decompensating after his surgery yesterday—his blood pressure is dipping and oxygen is down to 88%. Could you evaluate him bedside stat?", isCorrect: true },
          { text: "Your breathing looks a whole lot easier now with this extra oxygen.", isCorrect: false, reason: "Incorrect target: Reassuring patient evaluation note." },
          { text: "I am submitting a formal request for an annual leave shift swap next Friday.", isCorrect: false, reason: "Incorrect domain: HR leave request." }
        ]
      },
      {
        id: 104,
        module: "5",
        moduleTitle: "Module 5: Medication Safety & Refusal",
        visual: "Nurse at bedside medication cart scanning patient wristband while patient hesitates to take medication.",
        formalPrompt: "I understand your hesitation regarding dizziness. However, this medication manages your blood pressure. May I explain the importance of maintaining this dose?",
        instruction: "Select ALL options below that represent warm, therapeutic, informal ways to address patient medication refusal:",
        options: [
          { text: "I totally get why you're worried if it makes you feel dizzy! But this pill keeps your blood pressure steady. Can I quickly explain why it helps?", isCorrect: true },
          { text: "I completely understand why you'd want to skip it! I'll hold off for a second, re-check your blood pressure, and let the doctor know.", isCorrect: true },
          { text: "If you don't take this pill right now, you will be discharged immediately.", isCorrect: false, reason: "Incorrect tone: Coercive/Non-therapeutic distractor." },
          { text: "You must take all pills without objection according to hospital policy.", isCorrect: false, reason: "Incorrect tone: Rigid non-empathetic statement." }
        ]
      },
      {
        id: 105,
        module: "9",
        moduleTitle: "Module 9: Pediatric & Family Care",
        visual: "Pediatric clinic room. Mother holds a febrile toddler while nurse prepares temperature measurement.",
        formalPrompt: "We need to verify his weight-based paracetamol dosage and place a soft temperature probe under his arm to monitor his fever.",
        instruction: "Select ALL informal phrases suitable for reassuring the child and parent during this pediatric visit:",
        options: [
          { text: "I'm just going to pop this cool little temperature sticker under his arm—no ouchies at all, I promise!", isCorrect: true },
          { text: "Let's double-check his weight so we give him the exact right amount of liquid medicine to bring that fever down.", isCorrect: true },
          { text: "Execute primary trauma survey immediately and prepare 4 units O-negative blood!", isCorrect: false, reason: "Incorrect setting: ER Trauma Bay code alert." },
          { text: "We need to perform a terminal bleach disinfection procedure in this room.", isCorrect: false, reason: "Incorrect context: Infection control sanitation order." }
        ]
      },
      {
        id: 106,
        module: "10",
        moduleTitle: "Module 10: Critical Care & Emergency Escalation",
        visual: "ICU room. Cardiac monitor shows alarming heart rhythm while nurse alerts team.",
        formalPrompt: "Activate the Rapid Response Team immediately! Patient is experiencing acute respiratory arrest and hemodynamic instability.",
        instruction: "Select ALL correct urgent expressions used to call for immediate clinical assistance:",
        options: [
          { text: "Call a Code / Rapid Response for Room 210 right now! He's stopped breathing!", isCorrect: true },
          { text: "Get the Rapid Response team in here ASAP—his numbers are crashing!", isCorrect: true },
          { text: "Would you like a hot cup of herbal tea while we discuss your home routine?", isCorrect: false, reason: "Incorrect context: Long-term geriatric care conversation." },
          { text: "Please fill out this leave authorization form before clocking out tonight.", isCorrect: false, reason: "Incorrect context: Administrative HR request." }
        ]
      }
    ];

    // --- GAME STATE ---
    let currentScore = 0;
    let currentStreak = 0;
    let currentCaseIndex = 0;
    let selectedIndices = new Set();
    let isSoundOn = true;

    // --- DOM ELEMENTS ---
    const scoreDisplay = document.getElementById('scoreDisplay');
    const streakDisplay = document.getElementById('streakDisplay');
    const caseProgressDisplay = document.getElementById('caseProgressDisplay');
    const badgeCategory = document.getElementById('badgeCategory');
    const visualDescription = document.getElementById('visualDescription');
    const formalPrompt = document.getElementById('formalPrompt');
    const challengeInstruction = document.getElementById('challengeInstruction');
    const optionsContainer = document.getElementById('optionsContainer');
    const submitBtn = document.getElementById('submitBtn');
    const feedbackBanner = document.getElementById('feedbackBanner');
    const feedbackText = document.getElementById('feedbackText');
    const feedbackSubtext = document.getElementById('feedbackSubtext');
    const nextCaseBtn = document.getElementById('nextCaseBtn');
    const resetBtn = document.getElementById('resetBtn');
    const soundToggle = document.getElementById('soundToggle');
    const mainContainer = document.getElementById('mainContainer');

    // --- INITIALIZATION ---
    function initGame() {
      currentScore = 0;
      currentStreak = 0;
      currentCaseIndex = 0;
      updateHeaderStats();
      loadScenario(currentCaseIndex);
    }

    function updateHeaderStats() {
      scoreDisplay.textContent = currentScore;
      streakDisplay.textContent = `${currentStreak}🔥`;
      caseProgressDisplay.textContent = `${currentCaseIndex + 1} / ${gameScenarios.length}`;
    }

    function loadScenario(index) {
      if (index >= gameScenarios.length) {
        showFinalVictoryScreen();
        return;
      }

      const caseData = gameScenarios[index];
      selectedIndices.clear();
      feedbackBanner.classList.add('hidden');
      submitBtn.disabled = false;

      badgeCategory.textContent = caseData.moduleTitle;
      visualDescription.textContent = `📷 Scene: ${caseData.visual}`;
      formalPrompt.textContent = `"${caseData.formalPrompt}"`;
      challengeInstruction.textContent = caseData.instruction;

      // Build Multi-Choice Grid
      optionsContainer.innerHTML = '';
      caseData.options.forEach((opt, optIdx) => {
        const card = document.createElement('div');
        card.className = `option-card bg-slate-900/90 border-2 border-slate-700 hover:border-teal-500/80 p-4 rounded-xl cursor-pointer transition transform active:scale-98 flex items-start gap-3 text-slate-200 text-sm md:text-base select-none`;
        card.dataset.index = optIdx;

        card.innerHTML = `
          <div class="checkbox-box w-6 h-6 rounded-md border-2 border-slate-500 flex items-center justify-center flex-shrink-0 mt-0.5 transition">
            <span class="check-mark hidden text-teal-400 font-bold text-xs">✓</span>
          </div>
          <div class="flex-grow">
            ${opt.text}
          </div>
        `;

        card.addEventListener('click', () => toggleOptionSelect(optIdx, card));
        optionsContainer.appendChild(card);
      });

      updateHeaderStats();
    }

    function toggleOptionSelect(index, cardElement) {
      const checkbox = cardElement.querySelector('.checkbox-box');
      const checkMark = cardElement.querySelector('.check-mark');

      if (selectedIndices.has(index)) {
        selectedIndices.delete(index);
        cardElement.classList.remove('border-teal-400', 'bg-teal-950/40');
        cardElement.classList.add('border-slate-700');
        checkbox.classList.remove('border-teal-400', 'bg-teal-900');
        checkMark.classList.add('hidden');
      } else {
        selectedIndices.add(index);
        cardElement.classList.remove('border-slate-700');
        cardElement.classList.add('border-teal-400', 'bg-teal-950/40');
        checkbox.classList.add('border-teal-400', 'bg-teal-900');
        checkMark.classList.remove('hidden');
      }
    }

    // --- EVALUATION & SCORING LOGIC (+100 / -100) ---
    submitBtn.addEventListener('click', () => {
      const caseData = gameScenarios[currentCaseIndex];
      let isPerfect = true;
      let mistakes = [];

      // Check if user missed any correct options or picked any incorrect options
      caseData.options.forEach((opt, idx) => {
        const wasSelected = selectedIndices.has(idx);
        if (opt.isCorrect && !wasSelected) {
          isPerfect = false;
          mistakes.push(`Missed valid choice: "${opt.text}"`);
        } else if (!opt.isCorrect && wasSelected) {
          isPerfect = false;
          mistakes.push(`Selected incorrect option: "${opt.text}" (${opt.reason})`);
        }
      });

      submitBtn.disabled = true;
      feedbackBanner.classList.remove('hidden');

      if (isPerfect && selectedIndices.size > 0) {
        // --- PERFECT SCORE (+100) ---
        currentScore += 100;
        currentStreak++;
        soundFX.playCorrect();

        // Confetti burst
        if (typeof confetti === 'function') {
          confetti({ particleCount: 70, spread: 60, origin: { y: 0.7 } });
        }

        feedbackBanner.className = "p-4 rounded-xl border border-emerald-500/80 bg-emerald-950/80 text-emerald-200 text-center shadow-lg";
        feedbackText.innerHTML = `🎉 EXCELLENT EVALUATION! (+100 SCORE)`;
        feedbackSubtext.textContent = "You correctly identified all formal/informal matching registers for this clinical scenario!";

      } else {
        // --- INCORRECT PENALTY (-100 & BAM) ---
        currentScore -= 100;
        currentStreak = 0;
        soundFX.playIncorrect();

        // Visual BAM Shake Effect
        mainContainer.classList.add('bam-effect');
        setTimeout(() => mainContainer.classList.remove('bam-effect'), 500);

        feedbackBanner.className = "p-4 rounded-xl border border-rose-500/80 bg-rose-950/90 text-rose-200 text-center shadow-lg";
        feedbackText.innerHTML = `💥 BAM! INCORRECT SELECTION (-100 SCORE)`;
        feedbackSubtext.innerHTML = mistakes.length > 0 ? mistakes.join('<br>') : "You must select at least one correct matching option!";
      }

      updateHeaderStats();
    });

    nextCaseBtn.addEventListener('click', () => {
      currentCaseIndex++;
      loadScenario(currentCaseIndex);
    });

    resetBtn.addEventListener('click', () => {
      initGame();
    });

    soundToggle.addEventListener('click', () => {
      soundFX.enabled = !soundFX.enabled;
      soundToggle.textContent = soundFX.enabled ? "🔊 Sound: ON" : "🔇 Sound: OFF";
    });

    function showFinalVictoryScreen() {
      optionsContainer.innerHTML = '';
      formalPrompt.textContent = "🏆 CLINICAL MODULE CHALLENGE COMPLETED!";
      visualDescription.textContent = "Training Program Mastery Achieved";
      challengeInstruction.textContent = "Summary of your performance:";
      
      feedbackBanner.classList.remove('hidden');
      feedbackBanner.className = "p-6 rounded-2xl border border-amber-500/80 bg-slate-900/95 text-amber-300 text-center shadow-2xl";
      feedbackText.innerHTML = `FINAL SCORE: ${currentScore} POINTS`;
      feedbackSubtext.innerHTML = `
        <p class="text-sm text-slate-300 mt-2">You have completed all clinical scenarios across the nursing care plan syllabus!</p>
        <p class="text-xs text-amber-400 mt-1">Curriculum & Assessment Framework by <strong>Giyono Asfarrasyid</strong></p>
      `;
      nextCaseBtn.style.display = 'none';
      submitBtn.style.display = 'none';
    }

    // Start game on load
    initGame();
  </script>
</body>
</html>
